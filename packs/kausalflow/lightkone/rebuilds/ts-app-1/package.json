{
  "name": "lightkone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-pdfjs.mjs && vite",
    "build": "node scripts/copy-pdfjs.mjs && npm run build:impl && tsc --noEmit && vite build",
    "build:impl": "node scripts/build-impl.mjs",
    "preview": "vite preview",
    "test": "node --experimental-transform-types --no-warnings --test tests/*.test.ts",
    "test:impl": "node scripts/build-impl.mjs && bash scripts/test-impl.sh",
    "test:e2e": "node --experimental-transform-types --no-warnings tests/e2e.ts",
    "mcp-key": "node --experimental-transform-types --no-warnings -e \"import('./server/mcp-key.ts').then(async m => console.log(await m.newMcpKey()))\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  }
}
