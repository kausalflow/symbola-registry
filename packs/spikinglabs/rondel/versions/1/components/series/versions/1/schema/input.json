{
  "additionalProperties": false,
  "properties": {
    "cadence": {
      "anyOf": [
        {
          "enum": [
            "daily",
            "weekly",
            "biweekly",
            "monthly",
            "none"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cadence"
    },
    "date": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A calendar date, as the person sees it on their calendar.",
      "title": "Date"
    },
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Id"
    },
    "info": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Info"
    },
    "link": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Link"
    },
    "now": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A UTC moment, ISO 8601 with milliseconds.",
      "title": "Now"
    },
    "occ": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occ"
    },
    "occurrences": {
      "anyOf": [
        {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Meetings of the series by name.",
      "title": "Occurrences"
    },
    "op": {
      "enum": [
        "period",
        "base_period",
        "next_period",
        "next_after",
        "decide",
        "latest",
        "label",
        "room",
        "ics",
        "document"
      ],
      "title": "Op",
      "type": "string"
